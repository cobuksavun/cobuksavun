{
  "name": "cyber-academy-backend",
  "version": "0.1.0",
  "description": "SIEM-based cybersecurity training platform backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "psql -U postgres -d cyber_academy -f schema.sql",
    "db:create": "createdb cyber_academy",
    "db:drop": "dropdb cyber_academy",
    "db:seed": "psql -U postgres -d cyber_academy -f seeds.sql"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "pg": "^8.8.0",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.20"
  }
}
